# Activate only after issuing the ecop.aitomoney.online certificate.
server {
    listen 80;
    server_name ecop.aitomoney.online;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name ecop.aitomoney.online;
    ssl_certificate /etc/letsencrypt/live/ecop.aitomoney.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ecop.aitomoney.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 8k;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    location = /healthz { return 404; }
    location / {
        proxy_pass http://127.0.0.1:18765;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 240s;
        proxy_send_timeout 30s;
    }
}
